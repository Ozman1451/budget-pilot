# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Any Gemini model with function calling that your key has quota for
GEMINI_CHAT_MODEL=gemini-3.6-flash
# client-side requests/minute cap (free tier friendly)
GEMINI_RPM=10
# 1 = offline keyword router instead of Gemini (no key needed)
MOCK_CHAT=0
# dataset the app loads: 10k | 100k | 1m | 10m (default: 100k if present)
BP_DATASET=
# optimizer bootstrap iterations
N_BOOT=100
